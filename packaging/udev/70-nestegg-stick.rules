# Predicate reads only registration and block metadata; never mounts unknown media.
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", PROGRAM="/usr/bin/nestegg stick registered --parent /dev/%k", RESULT=="registered", ENV{UDISKS_IGNORE}="1"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_FS_TYPE}=="ext4", PROGRAM="/usr/bin/nestegg stick registered --uuid $env{ID_FS_UUID} --unit", RESULT=="?*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="nestegg-stick-pbs@%c.service"
