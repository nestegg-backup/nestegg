[Unit]
Description=nestegg backup run
Documentation=file:/usr/share/doc/nestegg/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/nestegg run --trigger timer
# 75 = backup server unreachable: try again at the next timer tick.
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
TimeoutStartSec=12h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
