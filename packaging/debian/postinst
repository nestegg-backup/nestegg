#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    systemd-sysusers nestegg.conf >/dev/null 2>&1 || groupadd --system nestegg 2>/dev/null || true
    systemd-tmpfiles --create nestegg.conf >/dev/null 2>&1 || true
    mkdir -p /etc/nestegg /var/lib/nestegg
    chmod 0755 /etc/nestegg
    chgrp nestegg /var/lib/nestegg 2>/dev/null || true
    chmod 0750 /var/lib/nestegg
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        if systemctl is-active --quiet nestegg.service; then
            systemctl restart nestegg.service || true
        fi
    fi
    if [ ! -e /etc/nestegg/config.toml ]; then
        echo "nestegg: run 'sudo nestegg init --help' to set up backups."
    fi
fi
exit 0
