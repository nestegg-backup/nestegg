#!/bin/sh
set -e
marker=/var/lib/nestegg/enabled-units
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    # Active removable-media workers must flush/unmount before their package
    # disappears. Never enable an instance: udev owns device activation.
    systemctl stop 'nestegg-stick-pbs@*.service' >/dev/null 2>&1 || true
    # Remember which units were enabled, so that installing the package again
    # enables them again (postinst). The state directory is kept on removal.
    enabled=""
    for unit in nestegg.service nestegg-backup.timer nestegg-notify.timer nestegg-hub.service; do
        if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
            enabled="$enabled $unit"
        fi
    done
    if [ -n "$enabled" ]; then
        [ -d /var/lib/nestegg ] || mkdir -m 0750 /var/lib/nestegg || true
        # shellcheck disable=SC2086 # one unit per line
        printf '%s\n' $enabled > "$marker" || true
    else
        rm -f "$marker"
    fi
    systemctl disable --now nestegg-backup.timer nestegg-notify.timer nestegg.service nestegg-hub.service >/dev/null 2>&1 || true
fi
exit 0
